{
  "name": "dokkan-team-builder",
  "private": true,
  "version": "0.1.0",
  "description": "Team building tools for Dragon Ball Z Dokkan Battle, served at builder.dokkandle.net.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "data": "node scripts/build-data.ts"
  },
  "dependencies": {
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
